# Private iCal URL list — same JSON format as GitHub variable AGENDA_ICAL_URLS_JSON_ARRAY
# Copy to .env.local and fill in real URLs for local sync testing.
# Not required for pnpm dev (uses committed events.generated.ts).

AGENDA_ICAL_URLS_JSON_ARRAY=["https://calendar.google.com/calendar/ical/.../private-.../basic.ics"]

# Cloudflare Web Analytics beacon (public token from Analytics → Web Analytics → Manage site).
# Required at build time for production. Leave empty in local dev if unused.
NEXT_PUBLIC_CF_BEACON_TOKEN=
